{
  "name": "sms-data-gateway",
  "version": "0.1.0",
  "description": "Gateway SMS plug-and-play y agnostico del proveedor para recopilar datos por SMS (sin internet del lado del ciudadano). Pensado para emergencias y proyectos civicos.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "bin": { "sms-gateway": "./dist/src/cli.js" },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "default": "./dist/src/index.js" }
  },
  "files": ["dist", "examples", "README.md", "LICENSE"],
  "scripts": {
    "dev": "tsx watch src/cli.ts examples/sos.config.ts",
    "start": "node dist/src/cli.js dist/examples/sos.config.js",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["sms", "gateway", "twilio", "android-sms-gateway", "venezuela", "emergency", "civic-tech", "offline"],
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "pg": "^8.22.0"
  }
}
