# Copia a .env y ajusta. NUNCA subas .env al repo.

# Secreto compartido del webhook. El proveedor/gateway debe enviar
#   .../sms?key=ESTE_VALOR   (o cabecera x-sms-key)
# Sin él, el endpoint rechaza TODO. Usa una cadena larga y aleatoria.
SMS_WEBHOOK_SECRET=

# Puerto del servidor (por defecto 8080).
PORT=8080

# Solo si usas postgresStorage:
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
